[Unit]
Description=Michi learning coach
After=network.target

[Service]
Type=simple
# adjust the path + user to wherever you put the repo (without User= the service
# runs as root and the database ends up root-owned)
User=youruser
WorkingDirectory=/home/youruser/michi/server
ExecStart=/usr/bin/node --experimental-sqlite index.js
Environment=PORT=4001
Environment=HOST=0.0.0.0
# IMPORTANT: set this to YOUR timezone. Streaks & the heatmap bucket completions by the
# server's local day, so a UTC-only box would mis-file evening activity. (`timedatectl
# list-timezones` to find yours.)
Environment=TZ=America/New_York
# To enable the optional local model layer (see README), uncomment:
# Environment=MICHI_LLM=1
# Environment=MICHI_LLM_MODEL=llama3.2:3b
Restart=on-failure
RestartSec=3

# basic hardening: the process can't gain privileges, and the filesystem is
# read-only to it except the data dir (adjust the path to match WorkingDirectory;
# the dir is created on first run, so run the app once before enabling the unit)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/youruser/michi/server/data
# the backups folder too — Settings' "Back up now" snapshots in-process, and a
# strict ProtectSystem would otherwise turn that button into an EROFS error.
# (the leading "-" means "skip if missing", so a box that hasn't run `make backup`
# yet still boots. NOTE: the mount namespace is fixed when the unit STARTS, so
# the folder must exist before then — creating it while the service runs isn't
# enough. To make in-app backups writable later: mkdir the folder, then
# `systemctl restart michi`.)
ReadWritePaths=-/home/youruser/michi/backups

[Install]
WantedBy=multi-user.target
